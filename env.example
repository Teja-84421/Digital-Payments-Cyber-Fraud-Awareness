# Copy this file to .env for local dev (vercel dev picks it up automatically).
# In production, add the same keys under Vercel -> Project -> Settings -> Environment Variables.

# --- TiDB (TiDB Cloud Serverless connection details) ---
TIDB_HOST=gateway01.xxxxxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxxxxxxx.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=digital_payments_awareness

# --- Sessions ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- SMTP (for sending the forgot-password OTP email) ---
# Works with Gmail (use an App Password, not your normal password),
# Brevo, SendGrid SMTP relay, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CyberSafe <youraddress@gmail.com>"

# --- Feedback form (optional) ---
# Where visitor feedback emails are sent. If not set, falls back to SMTP_USER.
FEEDBACK_TO_EMAIL=youraddress@gmail.com

# --- Google Sign-In ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Application type: Web application). See GOOGLE_SIGNIN_SETUP.md for the
# full walkthrough. No client secret is needed for this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- AI-generated quiz questions (via OpenRouter) ---
# From openrouter.ai -> Keys. Powers fresh quiz questions on every attempt
# instead of a fixed static bank. See QUIZ_AI_SETUP.md.
# If left unset, the quiz automatically falls back to its built-in
# static question bank — nothing breaks without this key.
OPENROUTER_API_KEY=sk-or-v1-your-api-key