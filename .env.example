# Copy this file to .env for local dev (vercel dev picks it up automatically).
# In production, add the same keys under Vercel -> Project -> Settings -> Environment Variables.

# --- TiDB (TiDB Cloud Serverless connection details) ---
TIDB_HOST=gateway01.xxxxxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxxxxxxx.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=digital_payments_awareness

# --- Sessions ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- SMTP (for sending the forgot-password OTP email) ---
# Works with Gmail (use an App Password, not your normal password),
# Brevo, SendGrid SMTP relay, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CyberSafe <youraddress@gmail.com>"
